// EXPECT_EXIT: 0
// EXPECT_STDOUT: "ABC."
//
// A lambda containing a `return` is called from inside a `while` loop.
// The lambda's `return` exits the *lambda*, not the surrounding `main`
// — the loop continues to its next iteration, and the trailing '.'
// after the loop still fires.
//
// Each call to `say(c)` prints `c` then returns; the dead `putchar('!')`
// after the return inside the lambda body never executes.
//
//   i=0: say('A')  → 'A'
//   i=1: say('B')  → 'B'
//   i=2: say('C')  → 'C'
//   loop exits, '.' fires once.
//
// Output: "ABC."

extern fn putchar(c: i32) -> i32;

fn main() -> i64 {
  let say = |c: i32| {
    putchar(c);
    return;
    putchar('!' as i32);
  };
  let mut i = 0;
  while i < 3 {
    say(('A' as i32) + (i as i32));
    i = i + 1;
  }
  putchar('.' as i32);
  0
}
