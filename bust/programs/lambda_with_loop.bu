// EXPECT_EXIT: 0
// EXPECT_STDOUT: "01!"
//
// A lambda whose body contains a `while` + `break`. Verifies that the
// codegen `loop_stack` is correctly scoped per lambda body — the lambda
// gets its own loop-context boundary, and `break` targets the lambda's
// own loop. The trailing `putchar('!')` after the loop *inside* the
// lambda proves `break` exited the loop, not the lambda.
//
// Output: "01!" — the loop prints 0, 1, breaks at i==2, then '!' fires
// before the lambda returns.

extern fn putchar(c: i32) -> i32;

fn main() -> i64 {
  let print_until_two = || {
    let mut i = 0;
    while true {
      if i == 2 { break; }
      putchar(('0' as i32) + (i as i32));
      i = i + 1;
    }
    putchar('!' as i32);
  };
  print_until_two();
  0
}
