// EXPECT_EXIT: 0
// EXPECT_STDOUT: "012"
//
// Short-circuit evaluation gating a `break` condition inside a `while`.
// The break-guard expression `i >= 3 || (i == 1 && false)` mixes both
// `||` and `&&`. The right side of `||` involves an `&&` whose RHS is
// always `false` — this side never causes a break, but more
// importantly, when `i >= 3` is *true* the entire expression
// short-circuits to `true` without ever evaluating the inner `&&`.
//
//   i=0: 0 >= 3 (false) || (0 == 1 && false)=(false && _)=false → no break
//   i=1: 1 >= 3 (false) || (1 == 1 && false)=(true && false)=false → no break
//   i=2: 2 >= 3 (false) || (2 == 1 && false)=(false && _)=false → no break
//   i=3: 3 >= 3 (true)  || _ (skipped) → break
//
// Output: "012" (digits 0, 1, 2 printed).

extern fn putchar(c: i32) -> i32;

fn main() -> i64 {
  let mut i = 0;
  while true {
    if i >= 3 || (i == 1 && false) { break; }
    putchar(('0' as i32) + (i as i32));
    i = i + 1;
  }
  0
}
